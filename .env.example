# Copy to .env for local/docker runs. On Render, PORT is injected automatically
# and X402_PAY_TO is set in the dashboard (Environment tab).

# Port to listen on (Render injects its own; default 8931)
PORT=8931

# Public USDC receiving address on Base. This is PUBLIC (it appears in the
# 402 challenge) — but set it as an env var rather than committing secrets.
# The private key is NEVER needed by this server (payments are verified
# on-chain via public RPC, not signed locally).
X402_PAY_TO=0xE972312a00F195F6bc1746ed6af43945509C94bA

# Optional: override where the used-tx ledger and logs are stored.
# X402_DATA_DIR=/data
